# ===== Supabase =====
# หาได้จาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# service_role key — ใช้เฉพาะฝั่ง server เท่านั้น ห้ามนำไปใส่ในโค้ดฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ชื่อ bucket สำหรับเก็บรูปลงเวลา (สร้างแบบ private)
SUPABASE_PHOTO_BUCKET=attendance-photos
# ถังเก็บไฟล์แนบของ Memo (รับไฟล์เอกสารได้)
SUPABASE_MEMO_BUCKET=marketing-files

# ===== Session =====
# สตริงสุ่มอย่างน้อย 32 ตัวอักษร ใช้เซ็น JWT ของ cookie
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ===== ทั่วไป =====
TZ=Asia/Bangkok

# PIN 6 หลักสำหรับเข้าระบบหลังบ้าน /admin
ADMIN_PIN=123456

# =============================================================================
# แอปข้อมูลสดจากระบบขาย (Db2) — โปรแกรม /db2 เรียกผ่าน server เท่านั้น
# =============================================================================
# URL สาธารณะของแอป Db2 (Tailscale Funnel หรือ Cloudflare Tunnel)
DB2_API_URL=https://sales.kmsgroup.app
DB2_API_URL_FALLBACK=https://db2-sales.tail9c6195.ts.net
# ค่าเดียวกับ API_KEY ใน .env.local ของแอป Db2 — บน Cloudflare ตั้งด้วย wrangler secret put DB2_API_KEY
DB2_API_KEY=
